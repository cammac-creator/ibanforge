{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cammac-creator/ibanforge",
  "title": "IBANforge",
  "description": "Check the bank behind an IBAN before you pay: bank-code check, BIC with source, bank-level sanctions",
  "version": "1.7.0",
  "websiteUrl": "https://ibanforge.com?src=mcp-registry",
  "repository": {
    "url": "https://github.com/cammac-creator/ibanforge",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "ibanforge-mcp",
      "version": "1.7.0",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.ibanforge.com/mcp"
    }
  ]
}
