# Server
PORT=3000
NODE_ENV=development

# REQUIRED in production: the salt of the pseudonymised client addresses in the
# request log (src/lib/stats.ts). With NODE_ENV=production and neither this nor
# SESSION_SECRET set, the API refuses to start rather than salt with a value
# written in this public repository. Generate it with openssl rand -hex 32.
# IP_HASH_SECRET=
# Older name, read only when IP_HASH_SECRET is absent. Set IP_HASH_SECRET instead.
# SESSION_SECRET=

# The site's address in the links the API writes for the file audit (its checkout
# and return pages, src/routes/audit.ts). Default https://ibanforge.com.
# PUBLIC_SITE_URL=https://ibanforge.com

# x402 micropayments (disabled by default — set X402_ENABLED=true to activate)
# X402_ENABLED=true
# WALLET_ADDRESS=0xYourWalletAddress
# Facilitator default in code is https://x402.org/facilitator (used when CDP keys absent)
# FACILITATOR_URL=https://x402.org/facilitator
# Coinbase CDP facilitator (preferred when set — overrides FACILITATOR_URL)
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# Explicit prod free mode (all paid endpoints free, loud warning) — leave unset normally
# IBANFORGE_FREE_MODE=false
# How long a facilitator call may hang, in ms. Defaults 5000/5000/6000.
# Keep every one of them UNDER the 8s shutdown drain (src/index.ts), or a call
# still in flight at shutdown gets its socket cut instead of an error response.
# X402_SUPPORTED_TIMEOUT_MS=5000
# X402_VERIFY_TIMEOUT_MS=5000
# X402_SETTLE_TIMEOUT_MS=6000

# CORS (production: MUST be an explicit comma-separated list, no wildcard; the
# API refuses to start without it, src/app.ts)
# CORS_ORIGIN=https://ibanforge.com,https://www.ibanforge.com

# Rate limit (requests per IP per minute; default 100, src/middleware/rate-limit.ts)
# RATE_LIMIT_PER_MIN=100

# The key the landing-page demo relay (/internal/playground, src/routes/playground.ts)
# spends its calls with. Unset: the relay answers 503 playground_unavailable.
# PLAYGROUND_API_KEY=
# A key the website's register pages present, when the site sets one apart. A call
# carrying either key passes the per-IP limiter above on the four routes the site
# calls (SITE_SERVER_KEY_ROUTES in src/middleware/rate-limit.ts). Unset: nothing changes.
# REGISTER_PAGES_API_KEY=

# Live MCP sessions the /mcp transport keeps in memory (SEC-04#1, optional).
# Default 300, unchanged. A whole number from 30 to 1000; anything else (a typo,
# 0, a decimal, out of range) keeps the default. A third is guaranteed to
# sessions opened with a valid key, a third to sessions without one. Both
# measurements of a session's weight are in src/lib/mcp-limits.ts.
# MCP_MAX_SESSIONS=300
# The Host names /mcp answers, comma-separated (DNS-rebinding protection,
# src/routes/mcp-http.ts). Unset in production: api.ibanforge.com and the host's
# own public domain. Set it only the day another hostname serves /mcp.
# MCP_ALLOWED_HOSTS=api.ibanforge.com

# Admin API (for managing API keys remotely) — generate with: openssl rand -hex 32
# ADMIN_SECRET=your-secret-here

# Optional: a backup-only key (src/lib/admin-auth.ts). It opens GET
# /v1/admin/backup and NO other route, so the nightly backup script does not
# have to hold ADMIN_SECRET. Sent in the same X-Admin-Secret header; the full
# ADMIN_SECRET keeps opening the backup as well. Unset or empty: nothing
# changes, only ADMIN_SECRET opens the backup. Generate it with
# openssl rand -hex 32, and never reuse the value of ADMIN_SECRET.
# BACKUP_TOKEN=

# Optional: the website's key (same header, same mechanism as BACKUP_TOKEN). It
# opens exactly the admin routes the site calls, SCOPED_ADMIN_KEYS.SITE_ADMIN_TOKEN
# in src/lib/admin-auth.ts, and answers 403 on every other admin route. The site
# sends it under the same name (frontend/.env.local.example). Set it HERE first,
# then on the site: a site that sends a key this API does not know yet gets 401
# on every admin read. Generate it with openssl rand -hex 32, never reusing another key's value.
# SITE_ADMIN_TOKEN=

# Optional: the keys of the server's scripts, one per trade (same header, same
# mechanism). Each opens exactly its list in SCOPED_ADMIN_KEYS (src/lib/admin-auth.ts)
# and answers 403 everywhere else. Set them HERE first, then hand each to its
# scripts. One openssl rand -hex 32 per variable: a value equal to ADMIN_SECRET or
# to another scoped key is IGNORED at start-up and raises the alert
# admin:scoped-key-reuse (names only, never the value).
# Mail synchronisation (mailboxes into the CRM, translations):
# MAIL_SYNC_TOKEN=
# Drafts and scheduled sends (what prepares a message, what sends it on time):
# MAIL_OUTREACH_TOKEN=
# Prospecting and enrichment:
# PROSPECTING_TOKEN=
# Visibility readings and the weekly digest (read their figures, write their own table):
# INDICATORS_TOKEN=
# Read-only, for reports and probes that never write (GET routes only):
# ADMIN_READ_TOKEN=

# Stats / admin endpoints (Bearer token required for /stats and /admin/*) — openssl rand -hex 32
# STATS_TOKEN=your-long-random-token-here

# The key of the operations feed cursors (src/lib/ops-cursor.ts). Unset: derived
# from STATS_TOKEN; with neither, a fixed development key that anyone can read in
# this repository. Set one of the two in production.
# OPS_CURSOR_SECRET=

# Two narrow tokens, each with its own door and never ADMIN_SECRET: the data
# robots' heartbeat (src/routes/ops-heartbeat.ts) and the drop of the weekly
# watch reports into the bulletin (src/routes/admin-bulletin.ts). Unset: that
# door refuses everything. openssl rand -hex 32 each.
# HEARTBEAT_TOKEN=
# BULLETIN_FEED_TOKEN=

# The x402 revenue reading on Base (src/routes/admin-revenue.ts). The RPC
# endpoint (default https://mainnet.base.org), the block span of one log query
# (default 10000, what that public endpoint accepts), and the payer wallets that
# are ours, comma-separated, so test traffic is never counted as revenue. Unset
# payers: the reading says it cannot tell. Never write a real wallet here.
# BASE_RPC_URL=https://mainnet.base.org
# RPC_LOG_CHUNK_SIZE=10000
# X402_INTERNAL_PAYERS=0xExampleWallet1,0xExampleWallet2

# Stripe — credit packs payment rail (alternative to x402)
# Get keys from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...     # from Developers > Webhooks endpoint config
# See docs/business/stripe-setup.md for full setup guide
#
# Payment links the webhook recognises as IBANforge's (SEC-09#2, optional).
# The ids (plink_...) of every link that sells a pack, Pro or OEM, comma- or
# space-separated; a recharge link shares the id of its pack. Read from the
# event itself (checkout.session.payment_link), no extra call to Stripe.
# Unset or empty: nothing changes. Set: OBSERVATION only, a payment from a
# link outside the list is delivered exactly as before and raises one ops
# alert per episode, with no personal data. Nothing is ever refused on it.
# STRIPE_PAYMENT_LINK_ALLOWLIST=plink_example1,plink_example2

# Partner handoffs — PayQR referral step in next_steps (generate_payment_qr).
# Off by default: both directions of the referral switch on together by
# agreement with the partner, not by deploy.
# PARTNER_PAYQR=1

# Outbound transactional mail (key delivery, verification codes, activation
# nudge). NOT SMTP: Railway blocks outbound SMTP below Pro, so mail leaves over
# HTTPS through the tabornio relay (see src/lib/mail-transport.ts). Unset means
# no mail is sent and nothing throws.
# MAIL_RELAY_URL=https://relay.example.net/api/relay/send
# MAIL_RELAY_SECRET=

# Two ceilings on the mail anyone can trigger without an account: every
# verification code (key creation, claim, device approval, account sign-in) plus
# the free-key mail of POST /v1/keys/generate, counted together over a sliding
# hour AND over a sliding 24 hours (src/lib/key-creation-guard.ts). Above
# either one, a free key is still issued but not e-mailed (the 201 says
# "key_mailed": false), and a code request answers 503 with Retry-After; paid
# key deliveries are never counted nor held. One ops alert per ceiling, at half
# of it, closed on its own after a calm hour. Each takes a positive integer;
# unset or anything else keeps its default.
# The hourly one bounds a burst: keep it above the sign-in ceiling
# (ACCOUNT_CODES_GLOBAL_PER_HOUR, 30) so sign-in yields first.
# UNAUTHENTICATED_MAILS_PER_HOUR=60
# The 24-hour one protects the sending mailbox, which also delivers paid keys:
# keep it under the provider's own 24-hour sending limit for that mailbox, with
# room left for paid deliveries and the operator's mail.
# UNAUTHENTICATED_MAILS_PER_DAY=150
# Account sign-in codes have their own 24-hour ceiling, counted on sign-in codes
# alone and never on the shared budget above (src/lib/account.ts): it adds to it.
# ACCOUNT_CODES_PER_DAY=60

# Kill switch for the daily activation nudge ("your key has not made its first
# call yet"), src/lib/activation-nudge-server.ts. Set to 1 and the sending half
# goes quiet immediately; the founder DRAFTS keep being written to the CRM,
# because a draft never leaves the building. Read back at
# GET /v1/admin/activation-nudges.
# ACTIVATION_NUDGE_DISABLED=1

# Crisis switch for the global key-creation breaker, src/lib/creation-breaker.ts.
# Set to 1 and the breaker never arms, an episode already running is DISARMED at
# the next pass (the degraded keys of that episode are lifted back on their own),
# and cohort revocation is switched off with it. The counter and the journal keep
# running: the measurement survives, only the effect stops. Read back at
# GET /v1/admin/breaker.
#
# NOTE: three switches, three distinct names, and confusing them is the failure
# this design exists to prevent. This one DISARMS the breaker;
# IBANFORGE_REVOCATION_ENABLED=1 is the opt-in that lets the cohort radar cut
# keys at all (absent = report-only); ANONYMOUS_TIER_DISABLED=1 closes the
# no-e-mail signup door. What protects ships armed, what cuts ships off.
# IBANFORGE_BREAKER_DISABLED=1
# The opt-in that lets the cohort radar cut keys at all; absent, it only reports.
# IBANFORGE_REVOCATION_ENABLED=1
# Closes the no-e-mail signup door (src/routes/api-keys.ts): keys already born keep
# working and can still be claimed. Read at each request, no redeploy needed.
# ANONYMOUS_TIER_DISABLED=1

# Operator notices and ops alerts on Telegram (src/lib/notify.ts,
# src/lib/ops-alert.ts): the bot token and the chat. Unset: nothing is sent and
# nothing throws.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Set to 1 and every ops alert is only logged, never sent (a local run).
# OPS_ALERTS_DISABLED=1
# Set to 1 to stop the hourly production probes (src/lib/ops-probes.ts).
# OPS_PROBES_DISABLED=1
# Set to 1 to stop the Monday digest of the landing doors (src/lib/door-board-digest.ts).
# DOOR_BOARD_DIGEST_DISABLED=1

# Internal accounts, kept out of the customer figures: fragments of e-mail
# addresses, comma-separated, matched anywhere in an address
# (src/lib/internal-accounts.ts), and the operator's addresses for the lifecycle
# radar (src/lib/lifecycle-radar.ts). Unset: those accounts count as customers.
# Set them on the host only: never a real address in this repository.
# CRM_INTERNAL_EMAILS=acme@example.com
# RADAR_INTERNAL_EMAILS=acme@example.com

# Drafts and translations written by a language model (forum replies, prospect
# radar: src/lib/forum-draft-gen.ts, src/lib/prospect-radar-server.ts). Unset:
# those steps are skipped and the scan report says so.
# ANTHROPIC_API_KEY=
# The forum radar (src/lib/forum-radar-server.ts): a read-only GitHub token
# (GitHub search refuses unauthenticated calls from the host; unset, that source
# is off), the GitHub login whose replies count as ours (default: the repository
# owner), and the Stack Exchange user id once that account exists.
# GITHUB_TOKEN=
# FORUM_GITHUB_LOGIN=
# SO_USER_ID=

# The file audit's reports kept before payment (src/lib/audit-jobs.ts), in bytes:
# the most one unpaid report may take, and the room all of them may take together.
# Beyond the first, the upload is refused; beyond the second, a new upload answers
# 503 capacity_reached with Retry-After. A paid report counts in neither. Only a
# whole positive number replaces the default.
# AUDIT_UNPAID_REPORT_MAX_BYTES=25165824
# AUDIT_UNPAID_STORAGE_BYTES=536870912

# Device grant (RFC 8628, src/lib/device-grant.ts): how long a poll is held and
# its tick, the held polls in flight (in all, per rail, per network), and the
# delay imposed on a 404 (floor and ceiling). Positive numbers; the values below
# are the defaults. The tests lower the first two.
# DEVICE_POLL_WAIT_MS=30000
# DEVICE_POLL_TICK_MS=3000
# DEVICE_POLLS_IN_FLIGHT_MAX=200
# DEVICE_POLLS_IN_FLIGHT_PER_RAIL=150
# DEVICE_POLLS_IN_FLIGHT_PER_IP=3
# DEVICE_MISS_DELAY_FLOOR_MS=120
# DEVICE_MISS_DELAY_MAX_MS=5000

# Google Search Console — the whole service-account key as one JSON line, for
# the dashboard's weekly card (GET /v1/admin/search-console). The account must
# be an owner of the https://ibanforge.com/ property; read-only scope. Unset
# means the card says "not configured" and nothing is called.
GSC_SA_JSON=

# FCA Financial Services Register — GET /v1/gb/firm/:frn (one UK firm per
# request, by FRN). Both come from the FS Developer portal
# (register.fca.org.uk/Developer/s/): the account e-mail is the API
# identifier, the key appears in the profile after confirmation. Unset means
# the route answers 503 not_configured before any credential is read, and
# nothing is called. Used under the FCA's written permission of 07/09/2026
# and its four conditions — see src/lib/fca-register.ts.
FCA_REGISTER_API_KEY=
FCA_REGISTER_API_EMAIL=

# Optional: proof of domain ownership for the ChatGPT app directory
# (src/routes/openai-domain.ts). The OpenAI portal shows a token; setting it
# here serves it, as plain text and byte for byte, at
# GET /.well-known/openai-apps-challenge. Unset or empty: that address answers
# 404. Set it on the host only, never in the repository, and paste it without a
# trailing space or newline (it is served exactly as written).
# OPENAI_APPS_CHALLENGE=

# Optional: override database paths
# BIC_DB_PATH=./data/bic.sqlite
# COMPLIANCE_DB_PATH=./data/compliance.sqlite
# STATS_DB_PATH=./data/stats.sqlite
# Reference tables read from files. The production image sets these three
# (Dockerfile, /app/reference/), because the volume covers data/. A missing or
# unreadable file never raises: that check answers as unavailable.
# UK_MODULUS_PATH=./data/uk-modulus.json
# DE_PRUEFZIFFER_PATH=./data/de-pruefziffer.json
# CH_LOCALITIES_PATH=./data/ch-localities.json

# Optional: private overlay of the data we may serve but not redistribute
# (src/lib/restricted-family.ts). Absolute paths to files OUTSIDE this
# repository, one per database; unset means the public databases alone, and
# "not consulted" where that data is missing. See docs/data-sources.md.
# RESTRICTED_BIC_OVERLAY_PATH=/app/data/private/restricted-bic.sqlite
# RESTRICTED_COMPLIANCE_OVERLAY_PATH=/app/data/private/restricted-compliance.sqlite
# Withdraws members of that family, named by member id or origin, comma-separated,
# at the restart a variable change triggers; GET /health names them under
# restricted_overlays.<base>.withdrawn, and a word that names nothing under
# withdrawn_unmatched.
# RESTRICTED_WITHDRAWN=

# Optional: registers served from a PRIVATE file each, under written permissions
# that cover API answers only, never this repository, an export or a page:
# Luxembourg, Greece, Estonia, Montenegro, Serbia (src/lib/lu-register.ts,
# gr-register.ts, ee-register.ts, me-register.ts, rs-register.ts). Absolute paths
# outside any git repository; unset, nothing changes. The page exports refuse to
# run while one of them, or an overlay above, is set (scripts/public-export-guard.ts).
# LU_REGISTER_PATH=
# GR_REGISTER_PATH=
# EE_REGISTER_PATH=
# ME_REGISTER_PATH=
# RS_REGISTER_PATH=

# Optional: pull those overlay files from the latest release of a PRIVATE GitHub
# repository that rebuilds them weekly (compliance) and monthly (BIC). See
# src/lib/restricted-overlay-pull.ts. Both unset: nothing is pulled, no network
# call is made, and /health says restricted_overlays.pull.state = "off". The
# token is fine-grained, with read-only "Contents" on that one repository. Only
# the databases whose RESTRICTED_*_OVERLAY_PATH is set are pulled. Never commit
# either value: the repository name lives in the variable alone.
# RESTRICTED_OVERLAY_PULL_REPO=owner/name
# RESTRICTED_OVERLAY_PULL_TOKEN=

# The stdio MCP server of this repository (npm run mcp, src/mcp/server.ts) relays
# its calls to this API. Default https://api.ibanforge.com; set it only for a
# self-hosted API (same variable as the npm package).
# IBANFORGE_API_BASE=https://api.ibanforge.com

# Tests and automation only, NEVER in production: lets a free key be created for
# a throwaway or reserved e-mail domain (example.com, test…), which the signup
# routes refuse otherwise (src/routes/api-keys.ts, src/routes/device-grant.ts).
# IBANFORGE_ADMIN_TEST_KEYS=true
