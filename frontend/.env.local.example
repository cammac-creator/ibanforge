NEXT_PUBLIC_API_URL=http://localhost:3001
DASHBOARD_PASSWORD=changeme

# CRM draft generation, server-side only. Left unset, the CRM composer's
# "Générer" button answers 503 and nothing else changes.
# TABORNIO_CRM_URL=https://example.com
# CRM_DRAFT_SECRET=changeme

# Names a generated draft must never write, per recipient domain.
#
# Format: one rule per entry, `domain=Name`, entries separated by `;` or by a
# newline. The domain matches its subdomains too (`example.com` also covers
# `someone@mail.example.com`), and it is compared lowercased. The name is used
# verbatim, spaces included.
#
# Each matching rule appends one line to the brief sent upstream:
#   IMPORTANT: never mention "Name" anywhere.
#
# Unset or empty, no line is appended and the brief goes upstream untouched.
# Applied in app/api/crm/generate-draft/route.ts so that neither the domains
# nor the names ever reach the browser or this repository.
# CRM_DRAFT_REDACTION_RULES="example.com=Acme; example.org=Globex"
