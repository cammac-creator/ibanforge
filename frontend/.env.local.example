# Frontend environment variables.
#
# FRT-07 (audit 2026-09-01): this file used to list two names out of the
# fourteen the code actually reads, so a Vercel project rebuilt from the
# repository came up with routes answering 503 in silence and getSessionSecret()
# throwing on the first production render. Every name read anywhere under app/,
# lib/ or components/ is listed here, with no value: the values live in the
# Vercel project settings and nowhere else.
#
# Copy to .env.local for local work. .env* is gitignored.

# --- API backend ------------------------------------------------------------

# Base URL of the IBANforge API, as the BROWSER sees it. Public by definition:
# it is inlined into the client bundle. Local: http://localhost:3001
NEXT_PUBLIC_API_URL=

# Base URL of the same API, as the SERVER sees it. Takes precedence over
# NEXT_PUBLIC_API_URL in route handlers and server components. Exists so the
# server can reach the API by a private address while the browser uses the
# public one; unset, the public value is used.
API_URL=

# --- Dashboard session ------------------------------------------------------

# Password of the single-user dashboard at /dashboard/login.
DASHBOARD_PASSWORD=

# HMAC key signing the dashboard session cookie. At least 32 random characters
# (openssl rand -hex 32). MUST be different from DASHBOARD_PASSWORD. Required in
# production: lib/auth.ts throws at first render if it is missing or too short.
SESSION_SECRET=

# Session generation, a positive integer, default 1. Bumping it invalidates
# every session token ever issued, at once, without rotating SESSION_SECRET.
# This is the revocation switch: /api/auth/logout only deletes the browser's
# copy of the cookie, so this is what cuts a token believed stolen (FRT-03).
SESSION_VERSION=

# --- Server-to-server secrets (never reach the browser) ---------------------

# Shared secret for the API's /v1/admin/* endpoints, sent as X-Admin-Secret by
# the CRM and dashboard route handlers. Unset, those routes answer 503.
ADMIN_SECRET=

# Bearer token for the API's /stats/* endpoints, read by /api/dashboard/revenue
# and by the public /status page. Unset, the status page shows no history.
STATS_TOKEN=

# API key used by /api/playground to call the paid v1 endpoints on the
# visitor's behalf. Unset, the public playground answers playground_unavailable.
PLAYGROUND_API_KEY=

# --- CRM draft generation ---------------------------------------------------

# Upstream that generates CRM drafts, and its shared secret. Left unset, the CRM
# composer's "Générer" button answers 503 and nothing else changes.
TABORNIO_CRM_URL=
CRM_DRAFT_SECRET=

# Names a generated draft must never write, per recipient domain.
#
# Format: one rule per entry, `domain=Name`, entries separated by `;` or by a
# newline. The domain matches its subdomains too (`example.com` also covers
# `someone@mail.example.com`), and it is compared lowercased. The name is used
# verbatim, spaces included.
#
# Each matching rule appends one line to the brief sent upstream:
#   IMPORTANT: never mention "Name" anywhere.
#
# Unset or empty, no line is appended and the brief goes upstream untouched.
# Applied in app/api/crm/generate-draft/route.ts so that neither the domains
# nor the names ever reach the browser or this repository.
# Example: CRM_DRAFT_REDACTION_RULES="example.com=Acme; example.org=Globex"
CRM_DRAFT_REDACTION_RULES=

# --- CRM address book -------------------------------------------------------

# JSON map of curated company facts, read by lib/company-enrichment.ts. Kept out
# of the repository because the list itself names real companies. Invalid JSON
# disables curated enrichment with a warning.
CRM_CURATED_COMPANIES=

# Comma-separated address fragments that mark a message as internal rather than
# a prospect reply (lib/crm/build-contacts.ts). A fragment matches anywhere in
# the address. Unset, nothing is treated as internal.
CRM_INTERNAL_EMAILS=

# The personal mailbox the CRM sends warm follow-ups from. A real address, so it
# stays out of this public repository.
CRM_WARM_ACCOUNT=
