{
  "action": "rules.insert",
  "id": null,
  "value": {
    "name": "Pages de registre AT, BE, SM : plafond par adresse",
    "description": "60 pages de code par adresse IP et par 10 minutes, en amont du cache, toutes langues. Audit du 29.09.2026. Source : frontend/firewall/register-pages-rate-limit.json",
    "active": true,
    "conditionGroup": [
      {
        "conditions": [
          {
            "type": "path",
            "op": "re",
            "value": "^/(?:(?:en|fr|de)/)?(?:at|be|sm)/[^/]+/?$"
          }
        ]
      }
    ],
    "action": {
      "mitigate": {
        "action": "rate_limit",
        "rateLimit": {
          "algo": "fixed_window",
          "window": 600,
          "limit": 60,
          "keys": ["ip"],
          "action": "rate_limit"
        },
        "actionDuration": null
      }
    }
  }
}
