{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ../CHANGELOG.md 2>/dev/null && exit 0 || exit 1",
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false,
      "codex/**": false,
      "claude/**": false
    }
  }
}
