{
  // Vérifie les types de scripts/ comme `npm run typecheck` le fait déjà pour
  // src/ (tsconfig.json) et comme le paquet npm le fait pour lui-même
  // (mcp/tsconfig.json). Avant le 02.09.2026, tsc ne voyait pas ce dossier :
  // `npm run typecheck` ne lisait que tsconfig.json, dont l'include est
  // `src/**/*`, alors que vitest lance les tests de ces scripts (audit QUA-07).
  // Le Dockerfile ne copie plus tout scripts/ depuis le 10.11.2026 : seulement
  // les scripts qu'il nomme, l'un lancé à la construction, l'autre embarqué
  // (scripts/dockerfile-watch-patterns.test.ts).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // "." rather than "scripts": every script that touches the database or
    // enrichment logic imports straight from src/ (e.g. ../src/lib/countries),
    // so scripts/ and src/ are not disjoint trees. rootDir only has to be an
    // ancestor of every file in the program; noEmit means it never drives an
    // output path.
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
