{
  "name": "n8n-nodes-ibanforge",
  "version": "0.1.0",
  "description": "IBAN validation, BIC/SWIFT lookup, Swiss clearing and compliance pre-checks for n8n workflows \u2014 backed by 6 national bank registers (121k+ BIC entries, 89 countries)",
  "keywords": [
    "n8n-community-node-package",
    "iban",
    "bic",
    "swift",
    "sepa",
    "banking",
    "compliance",
    "verification-of-payee",
    "fintech"
  ],
  "license": "MIT",
  "homepage": "https://ibanforge.com?src=n8n",
  "author": {
    "name": "IBANforge",
    "email": "support@ibanforge.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cammac-creator/ibanforge.git",
    "directory": "integrations/n8n"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/nodes/IbanForge && cp nodes/IbanForge/ibanforge.svg dist/nodes/IbanForge/",
    "lint": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/IbanForgeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/IbanForge/IbanForge.node.js"
    ]
  },
  "devDependencies": {
    "n8n-workflow": "^1.70.0",
    "typescript": "^5.6.0"
  }
}
