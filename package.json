{
  "name": "ibanforge",
  "version": "1.3.1",
  "mcpName": "io.github.cammac-creator/ibanforge",
  "description": "IBAN validation, BIC/SWIFT lookup, Swiss clearing, SEPA compliance, issuer classification and risk indicators for AI agents. 121,399 BIC entries (38,761 LEI-enriched via GLEIF; additional rows from SWIFT directory, Bundesbank, SIX, NBP, EBA Step2 SCT), 1,190 Swiss BC-Nummer from SIX. Supports 89 countries.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/server.js",
      "types": "./dist/mcp/server.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp src/db/bic_data.json dist/db/bic_data.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx src/db/seed.ts",
    "db:enrich": "tsx scripts/enrich-countries.ts",
    "db:seed-ch": "tsx scripts/seed-bc-nummer.ts",
    "compliance:refresh": "npx tsx scripts/refresh-compliance.ts",
    "veille": "tsx scripts/weekly-veille.ts",
    "mcp": "tsx src/mcp/server.ts",
    "docker:build": "docker build -t ibanforge .",
    "docker:run": "docker run -p 3000:3000 --env-file .env ibanforge",
    "check": "npm run typecheck && npm run lint && npm run test",
    "bic:enrich": "npx tsx scripts/enrich-bic-database.ts",
    "issuers:build": "node scripts/build-issuer-index.mjs",
    "iban-registry:check": "npx tsx scripts/check-iban-registry.ts",
    "admin": "tsx scripts/admin-keys.ts"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/nodemailer": "^8.0.1",
    "@x402/core": "^2.9.0",
    "@x402/evm": "^2.9.0",
    "@x402/extensions": "^2.9.0",
    "@x402/hono": "^2.8.0",
    "better-sqlite3": "^11.0.0",
    "hono": "^4.12.27",
    "nodemailer": "^9.0.1",
    "stripe": "^22.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.17.0",
    "eslint": "^10.1.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.0.0",
    "xlsx": "^0.18.5"
  },
  "bin": {
    "ibanforge-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "data/bic.sqlite",
    "data/compliance.sqlite"
  ],
  "keywords": [
    "iban",
    "bic",
    "swift",
    "sepa",
    "mcp",
    "validation",
    "fintech",
    "banking",
    "compliance",
    "x402",
    "iban-validator",
    "iban-validation",
    "bic-lookup",
    "swift-code",
    "bank-validation",
    "mcp-server",
    "ai-agent",
    "model-context-protocol",
    "viban",
    "risk-scoring",
    "gleif",
    "micropayments",
    "swiss",
    "clearing",
    "bc-nummer",
    "six"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cammac-creator/ibanforge"
  },
  "homepage": "https://ibanforge.com",
  "prepublishOnly": "npm run build",
  "engines": {
    "node": ">=20"
  }
}
