{
  "name": "ibanforge-mcp",
  "version": "1.7.0",
  "mcpName": "io.github.cammac-creator/ibanforge",
  "description": "MCP server for IBANforge: check the bank behind an IBAN before you pay. Validation in 89 countries, a bank-code verdict from the national register where one is read, the bank and BIC with their source, SEPA, SEPA Instant and VoP readiness, bank-level sanctions (OFAC, EU, UN). Not a name check.",
  "type": "module",
  "bin": {
    "ibanforge-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "pretest": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "iban",
    "bic",
    "swift",
    "sepa",
    "vop",
    "swiss",
    "bc-nummer",
    "qr-bill",
    "x402",
    "compliance",
    "sanctions",
    "payments",
    "payouts",
    "agent-payments",
    "usdc",
    "base",
    "fintech",
    "banking",
    "claude",
    "anthropic"
  ],
  "author": "IBANforge",
  "license": "MIT",
  "homepage": "https://ibanforge.com?src=npm-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cammac-creator/ibanforge.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/cammac-creator/ibanforge/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
